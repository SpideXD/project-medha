{
 "uid": "medha-load",
 "title": "Medha load test",
 "tags": [
  "medha"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "refresh": "5s",
 "time": {
  "from": "now-15m",
  "to": "now"
 },
 "timepicker": {
  "refresh_intervals": [
   "5s",
   "10s",
   "30s",
   "1m"
  ]
 },
 "panels": [
  {
   "id": 2,
   "type": "row",
   "title": "Right now",
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 0
   }
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Schools online",
   "description": "At this run's assumed users per school.",
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 0,
    "y": 1
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "graphMode": "area",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "locust_schools",
     "instant": false,
     "interval": "5s"
    }
   ]
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Simulated users",
   "description": "",
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 4,
    "y": 1
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "graphMode": "area",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "locust_users",
     "instant": false,
     "interval": "5s"
    }
   ]
  },
  {
   "id": 5,
   "type": "stat",
   "title": "Requests/s",
   "description": "",
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 8,
    "y": 1
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "graphMode": "area",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(medha_http_requests_total[1m]))",
     "instant": false,
     "interval": "5s"
    }
   ]
  },
  {
   "id": 6,
   "type": "stat",
   "title": "Failing (5xx)",
   "description": "",
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 12,
    "y": 1
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.005
       },
       {
        "color": "red",
        "value": 0.02
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "graphMode": "area",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(medha_http_requests_total{status=~\"5..\"}[1m])) / sum(rate(medha_http_requests_total[1m]))",
     "instant": false,
     "interval": "5s"
    }
   ]
  },
  {
   "id": 7,
   "type": "stat",
   "title": "DB pool in use",
   "description": "100% is where the freeze starts. Every other request waits for a connection.",
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 16,
    "y": 1
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.7
       },
       {
        "color": "red",
        "value": 0.95
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "graphMode": "area",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(medha_db_pool_checked_out) / sum(medha_db_pool_capacity)",
     "instant": false,
     "interval": "5s"
    }
   ]
  },
  {
   "id": 8,
   "type": "stat",
   "title": "Event loop blocked",
   "description": "Seconds since the event loop last ran. While high, every request in that worker waits.",
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 20,
    "y": 1
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.5
       },
       {
        "color": "red",
        "value": 2
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "graphMode": "area",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max(medha_event_loop_stalled_seconds)",
     "instant": false,
     "interval": "5s"
    }
   ]
  },
  {
   "id": 9,
   "type": "row",
   "title": "Each feature",
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 5
   }
  },
  {
   "id": 10,
   "type": "table",
   "title": "Throughput and speed by feature",
   "description": "Refreshes live. Errors counts 5xx and 429.",
   "gridPos": {
    "h": 11,
    "w": 24,
    "x": 0,
    "y": 6
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "decimals": 2
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "Req/s"
      },
      "properties": [
       {
        "id": "unit",
        "value": "reqps"
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "p50"
      },
      "properties": [
       {
        "id": "unit",
        "value": "s"
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "p95"
      },
      "properties": [
       {
        "id": "unit",
        "value": "s"
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "p99"
      },
      "properties": [
       {
        "id": "unit",
        "value": "s"
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Errors"
      },
      "properties": [
       {
        "id": "unit",
        "value": "percentunit"
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "DB time per req"
      },
      "properties": [
       {
        "id": "unit",
        "value": "s"
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "In progress"
      },
      "properties": [
       {
        "id": "unit",
        "value": "short"
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "SQL per req"
      },
      "properties": [
       {
        "id": "unit",
        "value": "short"
       }
      ]
     }
    ]
   },
   "options": {
    "showHeader": true,
    "sortBy": [
     {
      "displayName": "Req/s",
      "desc": true
     }
    ]
   },
   "transformations": [
    {
     "id": "joinByField",
     "options": {
      "byField": "feature",
      "mode": "outer"
     }
    },
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "Time 1": true,
       "Time 2": true,
       "Time 3": true,
       "Time 4": true,
       "Time 5": true,
       "Time 6": true,
       "Time 7": true,
       "Time 8": true,
       "Time 9": true,
       "Time 10": true,
       "Time 11": true
      },
      "renameByName": {
       "Value #A": "Req/s",
       "Value #B": "p50",
       "Value #C": "p95",
       "Value #D": "p99",
       "Value #E": "Errors",
       "Value #F": "In progress",
       "Value #G": "DB time per req",
       "Value #H": "SQL per req"
      }
     }
    }
   ],
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (feature) (rate(medha_http_requests_total{feature!=\"unmatched\"}[1m]))",
     "instant": true,
     "format": "table"
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.5, sum by (le, feature) (rate(medha_http_request_duration_seconds_bucket[1m])))",
     "instant": true,
     "format": "table"
    },
    {
     "refId": "C",
     "expr": "histogram_quantile(0.95, sum by (le, feature) (rate(medha_http_request_duration_seconds_bucket[1m])))",
     "instant": true,
     "format": "table"
    },
    {
     "refId": "D",
     "expr": "histogram_quantile(0.99, sum by (le, feature) (rate(medha_http_request_duration_seconds_bucket[1m])))",
     "instant": true,
     "format": "table"
    },
    {
     "refId": "E",
     "expr": "sum by (feature) (rate(medha_http_requests_total{{status=~\"5..|429\"}}[1m])) / sum by (feature) (rate(medha_http_requests_total[1m]))",
     "instant": true,
     "format": "table"
    },
    {
     "refId": "F",
     "expr": "sum by (feature) (medha_http_in_progress)",
     "instant": true,
     "format": "table"
    },
    {
     "refId": "G",
     "expr": "sum by (feature) (rate(medha_db_query_seconds_total[1m])) / sum by (feature) (rate(medha_http_requests_total[1m]))",
     "instant": true,
     "format": "table"
    },
    {
     "refId": "H",
     "expr": "sum by (feature) (rate(medha_db_queries_total[1m])) / sum by (feature) (rate(medha_http_requests_total[1m]))",
     "instant": true,
     "format": "table"
    }
   ]
  },
  {
   "id": 11,
   "type": "timeseries",
   "title": "Requests/s by feature",
   "description": "",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 17
   },
   "datasource": {
